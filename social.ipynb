    "mode_value = data_df[\"Daily_Usage_Hours\"].mode()[0]\n",
    "\n",
    "data_df.plot.hist(y=\"Daily_Usage_Hours\", figsize = (12, 6), color = \"cyan\",bins = 20,edgecolor = \"black\", title = \"DAILY USAGE HOURS\", density = True)\n",
    "data_df[\"Daily_Usage_Hours\"].plot.kde(color = \"Red\")\n",
    "\n",
    "plt.axvline(mode_value, color = \"yellow\", label = f\"Mode: {mode_value}\")\n",
    "plt.axvline(median_value, color = \"green\", linestyle = \"dotted\", label = f\"Median: {median_value}\")\n",
    "plt.axvline(mean_value, color = \"grey\", linestyle = \"dotted\", label = f\"Mean: {mean_value: .2f}\")\n",
    "\n",
    "plt.legend()\n",
    "plt.show()"
   ]
